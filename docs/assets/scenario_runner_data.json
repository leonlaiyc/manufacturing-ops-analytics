  "dispatch": {
    "records": {
      "assumptions": "policies = fifo, edd, critical_ratio, release_control; illustrative yield + congestion cost rates",
      "engine": "src/decision/dispatch_whatif.py",
      "run": "n_reps=30, CRN-paired",
      "seeds": "8000-8029"
    },
    "scenarios": {
      "cost": {
        "kpi": "best_policy = release_control (objective: total cost)",
        "winner": "Release control"
      },
      "ct": {
        "kpi": "best_policy = EDD (objective: avg cycle time)",
        "winner": "EDD"
      },
      "ontime": {
        "kpi": "best_policy = EDD (objective: on-time delivery)",
        "winner": "EDD"
      },
      "yieldrisk": {
        "kpi": "best_policy = release_control (objective: yield risk)",
        "winner": "Release control"
      }
    },
    "winners": {
      "cost": "Release control",
      "ct": "EDD",
      "ontime": "EDD",
      "yieldrisk": "Release control"
    }
  },
  "maintenance": {
    "records": {
      "assumptions": "station=LITHO (engineered bottleneck); E10 state layer; illustrative downtime + delay cost rates",
      "engine": "src/equipment/maintenance_whatif.py",
      "run": "n_reps=15, CRN-paired",
      "seeds": "6000-6014"
    },
    "scenarios": {
