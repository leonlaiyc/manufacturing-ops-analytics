    },
    "rows": {
      "ewma": {
        "result_en": "Alert on day 84",
        "result_zh": "day 84 alert"
      },
      "output": {
        "result_en": "No alert within 160 days",
        "result_zh": "160 \u5929\u5167\u6c92\u6709 alert"
      }
    },
    "scenarios": {
      "ewma": {
        "kpi": "alert_day = 84 &middot; remaining_horizon = 76 days"
